rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /pdfs/{uid}/{file} {
      // Ο χρήστης ανεβάζει μόνο στον δικό του φάκελο, max 10 MB, μόνο PDF
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
      // Διάβασμα: οποιοσδήποτε (τα QR ανοίγουν δημόσια)
      allow read: if true;
    }
  }
}
